{
    "name": "communitales/status-bus",
    "description": "Communitales StatusBus Component",
    "keywords": [
        "status-bus",
        "php"
    ],
    "type": "library",
    "homepage": "https://www.communitales.com",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "communitales/log": "^4.0",
        "symfony/http-foundation": "^7.4|^8.1",
        "symfony/translation": "^7.4|^8.1"
    },
    "require-dev": {
        "esi/phpunit-coverage-check": "^3.1",
        "friendsofphp/php-cs-fixer": "^v3.95",
        "monolog/monolog": "^3.11",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Communitales\\Component\\StatusBus\\": "src/StatusBus"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Communitales\\Test\\Unit\\Component\\StatusBus\\": "tests/Unit"
        }
    },
    "scripts": {
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon.dist",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "codecheck": [
            "@rector",
            "@php-cs-fixer",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
